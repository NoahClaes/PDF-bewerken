<?xml version='1.0' encoding='utf-8'?>
<!-- Android-versie van PDF Bewerken (Apache Cordova). Versie en versionCode worden bij het bouwen ingevuld. -->
<widget id="be.pdfbewerken.app" version="0.0.0" android-versionCode="1" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>PDF Bewerken</name>
    <description>Tekst, lettertypes, afbeeldingen en vormen in PDF-bestanden aanpassen</description>
    <author>PDF Bewerken</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="https://*/*" />
    <preference name="AndroidLaunchMode" value="singleTask" />
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-targetSdkVersion" value="34" />
    <preference name="BackgroundColor" value="0xfff4f5f8" />
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/icon.png" />
    <preference name="AndroidWindowSplashScreenBackground" value="#f4f5f8" />
    <preference name="SplashScreenDelay" value="0" />
    <preference name="FadeSplashScreenDuration" value="0" />
    <platform name="android">
        <icon src="res/icon.png" />
    </platform>
</widget>
